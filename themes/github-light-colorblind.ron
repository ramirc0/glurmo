// From the base16 scheme by Tinted Theming (https://github.com/tinted-theming).
Theme(
    name: "Github Light Colorblind",
    ui: (base: "#ffffff", surface: "#f6f8fa", overlay: "#d1d9e0", muted: "#818b98", subtle: "#59636e", text: "#454c54"),
    state: (free: "#d1d9e0", down: "#bc4c00", drain: "#9a6700"),
    users: ["#1b7c83", "#8250df", "#0969da", "#0550ae", "#953800", "#953800"],
    fonts: (sans: "Hanken Grotesk", mono: "CommitMono Nerd Font"),
)
