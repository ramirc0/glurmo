// From the base16 scheme by https://github.com/catppuccin/catppuccin.
Theme(
    name: "Catppuccin Macchiato",
    ui: (base: "#24273a", surface: "#1e2030", overlay: "#363a4f", muted: "#494d64", subtle: "#5b6078", text: "#cad3f5"),
    state: (free: "#363a4f", down: "#ed8796", drain: "#eed49f"),
    users: ["#8bd5ca", "#c6a0f6", "#8aadf4", "#a6da95", "#f5a97f", "#f0c6c6"],
    fonts: (sans: "Hanken Grotesk", mono: "CommitMono Nerd Font"),
)
