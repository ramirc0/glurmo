# A systemd user unit for the TimescaleDB that holds glurmo's history, set up as docs/guide.md
# describes. Install it beside glurmo.service and set ConditionHost the same way.
[Unit]
Description=TimescaleDB holding glurmo's history
After=network-online.target
ConditionHost=login

[Service]
RuntimeDirectory=glurmo-timescaledb
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/apptainer exec \
    --bind %h/.local/share/glurmo/timescaledb --bind %t/glurmo-timescaledb \
    %h/.local/share/glurmo/timescaledb/timescaledb-2.31.0-pg18.sif \
    postgres -D %h/.local/share/glurmo/timescaledb/data -k %t/glurmo-timescaledb -p 5433 \
    -c listen_addresses= -c unix_socket_permissions=0700 \
    -c shared_preload_libraries=timescaledb -c timescaledb.telemetry_level=off
# Fast shutdown. SIGTERM would wait for glurmo's connections to close.
KillSignal=SIGINT
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
