# A systemd user unit. Copy the binary to ~/.local/bin and this file to ~/.config/systemd/user. Set
# ConditionHost to the name `hostname` prints on the host that should serve. Globs such as `login*`
# work. Then run
#   systemctl --user enable --now glurmo
# With linger on, it keeps running after you log out.
[Unit]
Description=glurmo: sample the cluster and serve its live view
After=network-online.target
# Compute nodes share the home directory, so without it every Slurm job that starts your systemd
# would start another server.
ConditionHost=login

[Service]
ExecStart=%h/.local/bin/glurmo serve
Restart=on-failure
RestartSec=10
# Some clusters make the user journal unreadable, so the log is a file. glurmo-logrotate.timer rotates it.
StandardError=append:%h/.local/state/glurmo/serve.log
# A crash or an OOM kill leaves no line of glurmo's own.
ExecStopPost=/bin/sh -c 'echo "$$(date -Iseconds) %N ended: $$SERVICE_RESULT ($$EXIT_CODE $$EXIT_STATUS)" >&2'

[Install]
WantedBy=default.target
