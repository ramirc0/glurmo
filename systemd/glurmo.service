# A systemd user unit. Copy the binary to ~/.local/bin and this file to ~/.config/systemd/user, then run
#   systemctl --user enable --now glurmo
# With linger on, it keeps running after you log out.
[Unit]
Description=glurmo: sample the cluster and serve its live view
After=network-online.target

[Service]
ExecStart=%h/.local/bin/glurmo serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
